# 本文件用于本地开发参考；请复制为 deploy/.env（不要提交）

# MySQL（docker compose 初始化用；注意 init 脚本仅在“全新数据卷”时执行）
MYSQL_ROOT_PASSWORD=root
MYSQL_API_USER=linkforge_api
MYSQL_API_PASSWORD=linkforge_api

# 生产环境务必使用随机强密钥（>= 32 bytes）
JWT_SECRET=please_set_a_long_random_secret_at_least_32_bytes
# API Key 摘要使用独立、带 key id 的 pepper。新安装的旧变量别名用于滚动部署兼容。
API_KEY_CURRENT_KEY_ID=v1
API_KEY_CURRENT_PEPPER=please_set_an_independent_random_secret_at_least_32_bytes
# 旧实例只读取该变量；混部阶段必须与 current pepper 相同。全部升级后才进入真正轮换。
API_KEY_HMAC_PEPPER=${API_KEY_CURRENT_PEPPER}
API_KEY_PREVIOUS_KEY_ID=
API_KEY_PREVIOUS_PEPPER=
# 旧部署迁移时填原 API_KEY_HMAC_PEPPER；新部署没有历史行时保持为空。
API_KEY_LEGACY_PEPPER=
API_KEY_LEGACY_JWT_FALLBACK_ENABLED=false

# 自助注册默认关闭；本地首次创建租户可临时改为 true，生产建议使用邀请/后台初始化流程
AUTH_REGISTRATION_ENABLED=false

# 可选：HttpOnly Cookie 会话模式（默认关闭，前端需 build 时设置 VITE_AUTH_MODE=cookie）
JWT_COOKIE_ENABLED=false
JWT_COOKIE_NAME=lf_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
VITE_AUTH_MODE=bearer

# 统计访客指纹盐（用于 hash），不建议使用可猜测值
ANALYTICS_SALT=please_set_a_random_salt

# 应用点击配额的 Platform 查询异常是否放行；生产建议 false
ANALYTICS_QUOTA_FAIL_OPEN=false
ANALYTICS_QUOTA_LOOKUP_CACHE_TTL_SECONDS=30
ANALYTICS_QUOTA_LOOKUP_CACHE_MAX_ENTRIES=10000

# Redis 聚合写入失败时是否保护 Redirect 主链路；开启时必须监控 fail_open 指标。
ANALYTICS_EVENTS_FAIL_OPEN=true

# Snowflake 节点参数（多实例部署时必须保证唯一，避免 ID 冲突）
ID_WORKER_ID=2
ID_DATACENTER_ID=3

# 启动期严格配置校验；默认开启，避免示例密钥被直接用于共享/生产环境
APP_STRICT_CONFIG=true

# CORS 白名单（cookie 模式或跨域前端部署时需要配置；同域反代通常不需要）
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# 本地 compose 仅暴露 Nginx 网关入口，默认避开 80/8080 等常用宿主机端口
LINKFORGE_HTTP_BIND=127.0.0.1
LINKFORGE_HTTP_PORT=18080

# 对外访问的基准 URL（用于创建短链时拼接 shortUrl）
# - 建议指向网关/反代域名（例如本地 compose 的 Nginx： http://localhost:18080 ）
APP_BASE_URL=http://localhost:18080

# 可信代理链（CIDR）：仅当 remoteAddr 命中该列表时才采信 X-Real-IP / X-Forwarded-For
# - docker compose 已提供开箱即用默认值（常见内网网段）
# - 生产环境务必按你的网关/反代 IP/CIDR 精确配置，避免信任范围过大
EDGE_TRUSTED_PROXIES=
