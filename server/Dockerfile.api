# LinkForge API Service 镜像
# - 构建阶段：Maven + JDK17（与 maven-compiler release 对齐）
# - 运行阶段：JRE17

FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml /app/pom.xml
COPY platform /app/platform
COPY platform-web /app/platform-web
COPY platform-redis /app/platform-redis
COPY api-contract /app/api-contract
COPY api /app/api
COPY edge /app/edge

RUN mvn -q -DskipTests -pl api -am package

FROM eclipse-temurin:17-jre
WORKDIR /app

ENV SERVER_PORT=8080
EXPOSE 8080

COPY --from=build /app/api/target/linkforge-api-service-0.1.0-SNAPSHOT.jar /app/app.jar

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
