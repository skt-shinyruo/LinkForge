# LinkForge Redirect Edge Service 镜像
# - 构建阶段：Maven + JDK17
# - 运行阶段：JRE17

FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml /app/pom.xml
COPY platform /app/platform
COPY api /app/api
COPY edge /app/edge

RUN mvn -q -DskipTests -pl edge -am package

FROM eclipse-temurin:17-jre
WORKDIR /app

ENV SERVER_PORT=8081
EXPOSE 8081

COPY --from=build /app/edge/target/linkforge-redirect-edge-0.1.0-SNAPSHOT.jar /app/app.jar

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
