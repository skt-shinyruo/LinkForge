<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linkforge.accounts.infrastructure.persistence.mapper.ApiKeyMapper">

    <resultMap id="ApiKeyResultMap" type="com.linkforge.accounts.infrastructure.persistence.entity.ApiKeyEntity">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="applicationId" column="application_id"/>
        <result property="name" column="name"/>
        <result property="keyHash" column="key_hash"/>
        <result property="status" column="status"/>
        <result property="lastUsedAt" column="last_used_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="apiKeyColumns">
        id, tenant_id, application_id, name, key_hash, status, last_used_at, created_at
    </sql>

    <insert id="insert" parameterType="com.linkforge.accounts.infrastructure.persistence.entity.ApiKeyEntity">
        INSERT INTO api_keys (
            id,
            tenant_id,
            application_id,
            name,
            key_hash,
            status,
            last_used_at
        ) VALUES (
            #{id},
            #{tenantId},
            #{applicationId},
            #{name},
            #{keyHash},
            #{status},
            #{lastUsedAt}
        )
    </insert>

    <select id="findById" resultMap="ApiKeyResultMap">
        SELECT
        <include refid="apiKeyColumns"/>
        FROM api_keys
        WHERE id = #{param1}
    </select>

    <select id="findAllByTenantIdOrderByCreatedAtDesc" resultMap="ApiKeyResultMap">
        SELECT
        <include refid="apiKeyColumns"/>
        FROM api_keys
        WHERE tenant_id = #{param1}
        ORDER BY created_at DESC, id DESC
    </select>

    <update id="update" parameterType="com.linkforge.accounts.infrastructure.persistence.entity.ApiKeyEntity">
        UPDATE api_keys
        SET tenant_id = #{tenantId},
            application_id = #{applicationId},
            name = #{name},
            key_hash = #{keyHash},
            status = #{status},
            last_used_at = #{lastUsedAt}
        WHERE id = #{id}
    </update>

    <update id="updateLastUsedAt">
        UPDATE api_keys
        SET last_used_at = #{param2}
        WHERE id = #{param1}
    </update>
</mapper>
