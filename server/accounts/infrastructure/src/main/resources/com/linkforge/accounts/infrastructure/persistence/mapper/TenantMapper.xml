<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linkforge.accounts.infrastructure.persistence.mapper.TenantMapper">

    <resultMap id="TenantResultMap" type="com.linkforge.accounts.infrastructure.persistence.entity.TenantEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="tenantColumns">
        id, name, status, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.linkforge.accounts.infrastructure.persistence.entity.TenantEntity">
        INSERT INTO tenants (
            id,
            name,
            status
        ) VALUES (
            #{id},
            #{name},
            #{status}
        )
    </insert>

    <select id="findById" resultMap="TenantResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM tenants
        WHERE id = #{param1}
    </select>

    <select id="findByName" resultMap="TenantResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM tenants
        WHERE name = #{param1}
    </select>
</mapper>
