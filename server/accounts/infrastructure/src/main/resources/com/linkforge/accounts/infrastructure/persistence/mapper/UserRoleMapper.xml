<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linkforge.accounts.infrastructure.persistence.mapper.UserRoleMapper">

    <resultMap id="UserRoleIdResultMap" type="com.linkforge.accounts.infrastructure.persistence.entity.UserRoleId">
        <id property="userId" column="user_id"/>
        <id property="roleCode" column="role_code"/>
    </resultMap>

    <resultMap id="UserRoleResultMap" type="com.linkforge.accounts.infrastructure.persistence.entity.UserRoleEntity">
        <association property="id" javaType="com.linkforge.accounts.infrastructure.persistence.entity.UserRoleId" resultMap="UserRoleIdResultMap"/>
    </resultMap>

    <insert id="insert" parameterType="com.linkforge.accounts.infrastructure.persistence.entity.UserRoleEntity">
        INSERT INTO user_roles (
            user_id,
            role_code
        ) VALUES (
            #{id.userId},
            #{id.roleCode}
        )
    </insert>

    <select id="findAllByUserId" resultMap="UserRoleResultMap">
        SELECT user_id, role_code
        FROM user_roles
        WHERE user_id = #{param1}
    </select>

    <select id="findAllByUserIdIn" resultMap="UserRoleResultMap">
        SELECT user_id, role_code
        FROM user_roles
        WHERE user_id IN
        <foreach collection="list" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>
</mapper>
