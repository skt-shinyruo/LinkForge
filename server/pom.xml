<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-server-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>linkforge-server-parent</name>
    <description>LinkForge backend modular monolith (Maven reactor)</description>

    <modules>
        <module>shared-kernel</module>
        <module>foundation</module>
        <module>contracts/api</module>
        <module>contracts/redirect</module>
        <module>contracts/analytics</module>
        <module>accounts</module>
        <module>shortlink</module>
        <module>redirect</module>
        <module>analytics</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.5</jjwt.version>
        <commons-csv.version>1.10.0</commons-csv.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <shedlock.version>5.12.0</shedlock.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- Docker Desktop (2026+) 默认最低 API 版本为 1.44，旧版 1.41 会导致 Testcontainers 探测失败 -->
        <docker.api.version>1.44</docker.api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-foundation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-contract-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-contract-redirect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-contract-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-accounts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-shortlink</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-redirect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.linkforge</groupId>
                <artifactId>linkforge-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>${docker.api.version}</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
