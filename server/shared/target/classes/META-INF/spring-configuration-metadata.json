  "properties": [
    {
      "name": "app.analytics.dimensions.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用维度统计写入（Edge 写 Redis；API flush 落库）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Dimensions",
      "defaultValue": false
    },
    {
      "name": "app.analytics.dimensions.types",
      "type": "java.util.List<java.lang.String>",
      "description": "启用的维度类型列表（可选，为空时使用默认推荐集合）。 <p>示例：referer_domain, language, ua_family, os_family, device_type, utm_source<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Dimensions"
    },
    {
      "name": "app.analytics.events.consumer-name",
      "type": "java.lang.String",
      "description": "Redis Stream consumer 名称（可选）。 <p>建议：多实例部署时每个实例使用不同 consumerName（支持并行消费）；同时保持稳定以便重启后继续处理 pending。<\/p> <p>未配置时，API 会基于 HOSTNAME + workerId\/datacenterId 派生一个相对稳定的 consumer。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events"
    },
    {
      "name": "app.analytics.events.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用访问明细事件（Edge → Redis Stream → API 异步落库）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": false
    },
    {
      "name": "app.analytics.events.fail-open",
      "type": "java.lang.Boolean",
      "description": "Redis\/DB 异常时是否放行（fail-open）。默认 true，确保跳转主链路不被统计拖垮。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": true
    },
    {
      "name": "app.analytics.events.max-tracking-value-length",
      "type": "java.lang.Integer",
      "description": "追踪参数（utm_* 等）的 value 最大长度（落库与 stream 写入均会截断）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 128
    },
    {
      "name": "app.analytics.events.max-user-agent-length",
      "type": "java.lang.Integer",
      "description": "UA 原始字符串最大长度（落库与 stream 写入均会截断）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 512
    },
    {
      "name": "app.analytics.events.pending-reclaim-count",
      "type": "java.lang.Integer",
      "description": "每轮 pending reclaim 最多尝试接管的消息数。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 200
    },
    {
      "name": "app.analytics.events.pending-reclaim-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用 pending reclaim（通过 XPENDING + XCLAIM 接管已下线 consumer 的 pending）。 <p>用于处理 consumer 漂移\/重启导致的 pending 积压，避免明细长期不落库。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": true
    },
    {
      "name": "app.analytics.events.pending-reclaim-min-idle-ms",
      "type": "java.lang.Long",
      "description": "pending reclaim 的最小 idle 时间（毫秒）。仅接管“已闲置超过该阈值”的 pending，避免抢占正在处理的 consumer。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 60000
    },
    {
      "name": "app.analytics.events.retention-days",
      "type": "java.lang.Integer",
      "description": "访问明细保留天数（用于定期清理），<=0 表示不清理（不推荐）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 14
    },
    {
      "name": "app.analytics.events.sample-rate",
      "type": "java.lang.Double",
      "description": "采样率（0~1）。默认建议小流量启用可设为 1；公网高 QPS 场景建议 0.01~0.2。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 0.1
    },
    {
      "name": "app.analytics.events.stream-max-len",
      "type": "java.lang.Long",
      "description": "Redis Stream 近似最大长度（用于控制内存），<=0 表示不 trim（不推荐）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics$Events",
      "defaultValue": 200000
    },
    {
      "name": "app.analytics.flush-backfill-days",
      "type": "java.lang.Integer",
      "description": "flush 回补窗口（天数，包含今天）。 <p>用于定时作业停摆\/部署中断后的追赶补齐：会尝试 flush 最近 N 天的 active-set。<\/p> <p>注意：窗口越大，active-set 扫描与落库开销越高；建议结合数据规模调整。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics",
      "defaultValue": 7
    },
    {
      "name": "app.analytics.redis-key-ttl-days",
      "type": "java.lang.Long",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics",
      "defaultValue": 0
    },
    {
      "name": "app.analytics.salt",
      "type": "java.lang.String",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics"
    },
    {
      "name": "app.analytics.tracking-param-allowlist",
      "type": "java.util.List<java.lang.String>",
      "description": "允许采集的“追踪类”Query 参数白名单（可选，支持前缀通配：utm_*）。 <p>说明：该白名单仅用于统计维度\/明细采集，不影响 Redirect 的 query 透传策略。<\/p> <p>安全默认值在 Edge 侧做兜底：仅采集 utm_* \/ gclid \/ fbclid。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Analytics"
    },
    {
      "name": "app.base-url",
      "type": "java.lang.String",
      "sourceType": "com.linkforge.platform.config.AppProperties"
    },
    {
      "name": "app.cors.allow-credentials",
      "type": "java.lang.Boolean",
      "description": "是否允许携带凭证（cookie 模式需要开启）。开启后必须使用明确白名单，禁止 \"*\"。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Cors",
      "defaultValue": false
    },
    {
      "name": "app.cors.allowed-origins",
      "type": "java.util.List<java.lang.String>",
      "description": "允许的来源白名单（支持逗号分隔环境变量绑定）。 <p>未配置时默认使用 allowOriginPatterns=\"*\" 且 allowCredentials=false（仅推荐用于本地开发）。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Cors"
    },
    {
      "name": "app.edge.risk-control.bot.block",
      "type": "java.lang.Boolean",
      "description": "是否对 bot 直接拒绝（403）。默认建议 false（降频优先，降低误伤）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Edge$RiskControl$BotPolicy",
      "defaultValue": false
    },
    {
      "name": "app.edge.risk-control.bot.enabled",
      "type": "java.lang.Boolean",
      "sourceType": "com.linkforge.platform.config.AppProperties$Edge$RiskControl$BotPolicy",
      "defaultValue": false
    },
    {
      "name": "app.edge.risk-control.bot.ip-max-requests",
      "type": "java.lang.Long",
      "description": "bot 流量更严格的单 IP 阈值（与 rateLimit.windowSeconds 同窗口）。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Edge$RiskControl$BotPolicy",
      "defaultValue": 30
    },
    {
      "name": "app.edge.risk-control.bot.user-agent-keywords",
      "type": "java.util.List<java.lang.String>",
      "description": "识别 bot 的 UA 关键字（包含匹配）。为空表示不启用 bot 识别。",
      "sourceType": "com.linkforge.platform.config.AppProperties$Edge$RiskControl$BotPolicy"
    },
    {
      "name": "app.edge.risk-control.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用 \/r\/** 风控（仅影响 Edge 服务）。 <p>注意：若未正确配置 trusted-proxies 且流量经网关转发，按 IP 限流可能会聚合到网关 IP。<\/p>",
      "sourceType": "com.linkforge.platform.config.AppProperties$Edge$RiskControl",
      "defaultValue": false
    },
    {
      "name": "app.edge.risk-control.ip-allowlist",
      "type": "java.util.List<java.lang.String>",
