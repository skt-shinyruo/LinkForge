<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linkforge.shortlink.infrastructure.persistence.mapper.ShortLinkQueryMapper">

    <resultMap id="ShortLinkResultMap" type="com.linkforge.shortlink.infrastructure.persistence.entity.ShortLinkEntity">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="code" column="code"/>
        <result property="originalUrl" column="original_url"/>
        <result property="note" column="note"/>
        <result property="enabled" column="enabled"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="archivedAt" column="archived_at"/>
        <result property="redirectStatusCode" column="redirect_status_code"/>
        <result property="previewEnabled" column="preview_enabled"/>
        <result property="unavailableLandingUrl" column="unavailable_landing_url"/>
        <result property="queryForwardMode" column="query_forward_mode"/>
        <result property="queryForwardAllowlist" column="query_forward_allowlist"/>
        <result property="createdByType" column="created_by_type"/>
        <result property="createdBy" column="created_by"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="shortLinkColumns">
        id,
        tenant_id,
        code,
        original_url,
        note,
        enabled,
        expires_at,
        archived_at,
        redirect_status_code,
        preview_enabled,
        unavailable_landing_url,
        query_forward_mode,
        query_forward_allowlist,
        created_by_type,
        created_by,
        version,
        created_at,
        updated_at
    </sql>

    <select id="findByTenantIdAndId" resultMap="ShortLinkResultMap">
        SELECT
        <include refid="shortLinkColumns"/>
        FROM short_links
        WHERE tenant_id = #{param1}
          AND id = #{param2}
        LIMIT 1
    </select>

    <select id="findByCode" resultMap="ShortLinkResultMap">
        SELECT
        <include refid="shortLinkColumns"/>
        FROM short_links
        WHERE code = #{param1}
        LIMIT 1
    </select>

    <select id="findActiveByCode" resultMap="ShortLinkResultMap">
        SELECT
        <include refid="shortLinkColumns"/>
        FROM short_links
        WHERE code = #{param1}
          AND archived_at IS NULL
        LIMIT 1
    </select>

    <sql id="searchWhere">
        <where>
            tenant_id = #{tenantId}

            <choose>
                <when test="archived">
                    AND archived_at IS NOT NULL
                </when>
                <otherwise>
                    AND archived_at IS NULL
                </otherwise>
            </choose>

            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>

            <if test="keyword != null and keyword != ''">
                AND (
                    LOWER(code) LIKE CONCAT('%', LOWER(#{keyword}), '%')
                    OR LOWER(original_url) LIKE CONCAT('%', LOWER(#{keyword}), '%')
                    OR LOWER(note) LIKE CONCAT('%', LOWER(#{keyword}), '%')
                )
            </if>

            <if test="tag != null and tag != ''">
                AND EXISTS (
                    SELECT 1
                    FROM link_tags lt
                    JOIN tags t ON t.id = lt.tag_id
                    WHERE lt.link_id = short_links.id
                      AND t.tenant_id = short_links.tenant_id
                      AND t.name = #{tag}
                )
            </if>
        </where>
    </sql>

    <select id="countSearch" resultType="long">
        SELECT COUNT(*)
        FROM short_links
        <include refid="searchWhere"/>
    </select>

    <select id="listSearch" resultMap="ShortLinkResultMap">
        SELECT
        <include refid="shortLinkColumns"/>
        FROM short_links
        <include refid="searchWhere"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
